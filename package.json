{
  "name": "genai-span-doctor",
  "version": "0.2.0",
  "description": "Audit exported OTLP traces for LLM token-attribute dialects, cache-inclusive token semantics and backend visibility, and emit a Collector transform (OTTL) fix.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "genai-span-doctor": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "data",
    "examples",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opentelemetry",
    "otlp",
    "genai",
    "llm",
    "tokens",
    "openinference",
    "ottl",
    "observability"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/src/cli.js examples/mixed-dialects.otlp.json --fail-on none",
    "fixtures": "node scripts/make-fixtures.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arizeai/openinference-semantic-conventions": "2.17.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/otlp-transformer": "0.223.2",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@traceloop/ai-semantic-conventions": "0.27.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
