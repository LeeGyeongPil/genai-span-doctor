{
  "schemaVersion": 1,
  "description": "Which span attributes each backend view reads for token usage. These lists are conservative: a key that is not listed is treated as not read. Re-check on backend upgrades.",
  "default": "otel",
  "backends": {
    "otel": {
      "label": "Generic OTel backend (reads gen_ai.usage.* standard names only)",
      "input": ["gen_ai.usage.input_tokens"],
      "output": ["gen_ai.usage.output_tokens"],
      "cacheRead": ["gen_ai.usage.cache_read.input_tokens"],
      "cacheWrite": ["gen_ai.usage.cache_creation.input_tokens"],
      "sources": [
        { "url": "https://opentelemetry.io/docs/specs/semconv/registry/attributes/gen-ai/", "checked": "2026-11-16" }
      ]
    },
    "langfuse": {
      "label": "Langfuse (OTel ingestion)",
      "input": ["gen_ai.usage.input_tokens", "gen_ai.usage.prompt_tokens", "llm.token_count.prompt"],
      "output": ["gen_ai.usage.output_tokens", "gen_ai.usage.completion_tokens", "llm.token_count.completion"],
      "cacheRead": ["gen_ai.usage.cache_read.input_tokens", "llm.token_count.prompt_details.cache_read"],
      "cacheWrite": ["gen_ai.usage.cache_creation.input_tokens", "llm.token_count.prompt_details.cache_write"],
      "sources": [
        { "url": "https://langfuse.com/integrations/native/opentelemetry", "checked": "2026-11-16" },
        { "url": "https://github.com/langfuse/langfuse/issues/13571", "checked": "2026-11-16" }
      ]
    },
    "phoenix": {
      "label": "Arize Phoenix (>= 15.10.0, converts gen_ai.usage.* on ingest)",
      "input": ["llm.token_count.prompt", "gen_ai.usage.input_tokens"],
      "output": ["llm.token_count.completion", "gen_ai.usage.output_tokens"],
      "cacheRead": ["llm.token_count.prompt_details.cache_read", "gen_ai.usage.cache_read.input_tokens"],
      "cacheWrite": ["llm.token_count.prompt_details.cache_write", "gen_ai.usage.cache_creation.input_tokens"],
      "sources": [
        { "url": "https://arize.com/docs/phoenix/release-notes/05-2026/05-15-2026-otel-semconv-conversion.md", "checked": "2026-11-16" },
        { "url": "https://community.arize.com/x/phoenix-support/en0ssk5vvu7z/troubleshooting-token-usage-in-phoenix-tracing-set", "checked": "2026-11-16" }
      ]
    }
  }
}
